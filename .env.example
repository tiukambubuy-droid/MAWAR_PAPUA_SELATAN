# AUTH-001: konfigurasi hanya dibaca pada request dan autentikasi fail-closed bila kosong/tidak valid.
MAWAR_AUTH_USERNAME=
MAWAR_AUTH_PASSWORD_HASH=
MAWAR_AUTH_SESSION_SECRET=

# Buat nilai lokal dengan: npm run auth:generate
# Jangan commit .env.local atau credential sebenarnya.
# Session akun tunggal bersifat stateless selama 60 menit dan tidak dapat dicabut terpusat.
# Limiter login berbasis memory per-instance; produksi jangka panjang memerlukan central store.
